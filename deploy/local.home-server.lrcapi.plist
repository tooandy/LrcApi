<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.home-server.lrcapi</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Documents/Code/LrcApi/scripts/start-native.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LRCAPI_LISTEN_PORT</key><string>28883</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/HomeServer/LrcAPI-stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/HomeServer/LrcAPI-stderr.log</string>
</dict>
</plist>
